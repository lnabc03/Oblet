{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oblet",
  "version": "0.9.0",
  "identifier": "com.oblet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "弋鹓 (lnabc03)",
    "copyright": "Copyright © 2026 弋鹓 (lnabc03)",
    "shortDescription": "轻量独立的 Markdown / TXT 编辑器",
    "longDescription": "Oblet：支持 Markdown 与 TXT 的独立编辑器，单窗口多 Tab，GitHub 风格 HTML 安全渲染，序列化保真。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
